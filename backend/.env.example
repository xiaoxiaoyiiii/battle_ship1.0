# Environment names keep the current deployment semantics.
# Required: startup fails fast and names SECRET_KEY when this is missing/blank.
SECRET_KEY=

# Optional (defaults match the old stack).
HOST=0.0.0.0
PORT=5000
BATTLESHIP_DB_PATH=./battleship.db
TURN_TIMEOUT_SECONDS=90
CHAIN_DISPLAY_DELAY_SECONDS=1.2
ENABLE_TEST_EVENTS=0
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DEBUG_ADMIN_USER_IDS=
# Optional: where the built Vue shell lives (default: <repo>/frontend/dist).
# FRONTEND_DIST=frontend/dist
LOG_LEVEL=INFO
LOG_JSON=1

# Removed in Phase 5 (leaving any of them set fails fast):
# BACKEND_STACK, LEGACY_WORKTREE, FRONTEND_MODE=legacy,
# ARENA_SCREENS_MODE, ARENA_SCREEN_LIST
