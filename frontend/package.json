{
  "name": "battleship-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-card-data.mjs && node scripts/check-contract.mjs && vite build",
    "build:test": "node scripts/sync-card-data.mjs && node scripts/check-contract.mjs && vite build --mode test",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.0",
    "socket.io-client": "^4.7.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
