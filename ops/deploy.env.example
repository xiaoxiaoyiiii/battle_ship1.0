# /etc/battleship/battleship.env  (EnvironmentFile for ops/systemd/battleship.service)
# Copy this file, fill in SECRET_KEY, keep the rest as needed.
#
# There is exactly one stack after Phase 5. The migration-window selector and
# legacy-worktree variables were removed; keeping them in a deployed env fails fast.

# Required: startup fails before binding the port and names this variable.
SECRET_KEY=change-me-to-a-long-random-string

HOST=0.0.0.0
PORT=5000
BATTLESHIP_DB_PATH=/var/lib/battleship/battleship.db

# Comma-separated origins; use the public origin(s) in production.
CORS_ORIGINS=http://127.0.0.1:5000

TURN_TIMEOUT_SECONDS=90
CHAIN_DISPLAY_DELAY_SECONDS=1.2

# Debug socket events stay unavailable unless this is explicitly 1.
ENABLE_TEST_EVENTS=0

# Optional: override the built frontend location (default: <checkout>/frontend/dist).
# FRONTEND_DIST=/opt/battleship/frontend/dist

LOG_LEVEL=INFO
LOG_JSON=1