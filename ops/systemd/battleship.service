[Unit]
Description=Battleship 1.0 (FastAPI + python-socketio + Vue shell)
Documentation=file:///opt/battleship/ops/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=battleship
Group=battleship
WorkingDirectory=/opt/battleship
# Every value the process reads lives in this file (template: ops/deploy.env.example).
# SECRET_KEY has no default: a missing/blank key aborts startup before the port binds.
EnvironmentFile=/etc/battleship/battleship.env
# Defaults for the two variables the command line expands; EnvironmentFile overrides.
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# Alembic upgrade + pre-migration backup + verification. A failure keeps the old
# database and exits before the new process starts.
ExecStartPre=/opt/battleship/.venv/bin/python /opt/battleship/ops/migrate.py
ExecStart=/opt/battleship/.venv/bin/python -m uvicorn battleship.main:app --host ${HOST} --port ${PORT} --log-level warning --no-access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

# Modest hardening; the app only needs its database directory and the checkout.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/battleship

[Install]
WantedBy=multi-user.target
